{
  "name": "tyrant-engine",
  "version": "0.1.0",
  "private": true,
  "main": "./integrations/dsh/index.js",
  "type": "module",
  "engines": {
    "node": ">=20",
    "dsh": ">=0.2.2-0 <0.3.0-0"
  },
  "scripts": {
    "start": "bun run src/index.ts",
    "dev": "bun --watch src/index.ts",
    "build:command-hook": "bun build src/adapters/command-hook.ts --target bun --minify --outfile integrations/command-hook.js",
    "build:dsh": "bun build integrations/dsh/index.ts --target node --minify --outfile integrations/dsh/index.js",
    "build:opencode": "bun build integrations/opencode/index.ts --target bun --minify --external @opencode/plugin --outfile integrations/opencode/index.js",
    "build:integrations": "bun run build:command-hook && bun run build:dsh && bun run build:opencode",
    "sync:ai-memory-tools": "bun run scripts/sync-ai-memory-tools.ts",
    "setup:project": "bun run src/adapters/project-setup.ts",
    "test": "bun test",
    "typecheck": "tsc --noEmit"
  },
  "dsh": {
    "bundle": {
      "patch": "./integrations/dsh/cordis.patch.yml"
    }
  },
  "dependencies": {
    "@modelcontextprotocol/client": "^2.0.0",
    "@modelcontextprotocol/server": "^2.0.0",
    "zod": "^4.1.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.0",
    "typescript": "^5.9.0"
  },
  "peerDependencies": {
    "@opencode/plugin": "*"
  },
  "peerDependenciesMeta": {
    "@opencode/plugin": { "optional": true }
  }
}
